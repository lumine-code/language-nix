{
  "name": "language-nix",
  "author": "lumine-code",
  "version": "1.0.0",
  "files": [
    "grammars",
    "lib",
    "settings",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "description": "Nix language support.",
  "keywords": [
    "nixos",
    "flake",
    "derivation",
    "reproducible",
    "package-manager"
  ],
  "repository": "https://github.com/lumine-code/language-nix",
  "bugs": {
    "url": "https://github.com/lumine-code/language-nix/issues"
  },
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-n": "^18.6.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "specPackages": [
    "symbol-tree-sitter",
    "language-shellscript",
    "bracket-matcher",
    "language-source"
  ],
  "overrides": {
    "eslint@^10.15.0": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.9"
    }
  }
}
