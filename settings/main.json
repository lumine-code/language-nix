{
  ".source.nix": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\""]
    },
    "editor": {
      "commentStart": "# ",
      "nonWordCharacters": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?…",
      "commentDelimiters": {
        "line": "#",
        "block": ["/*", "*/"]
      }
    }
  }
}
