{
  "name": "Nix",
  "scopeName": "source.nix",
  "type": "tree-sitter",
  "parser": "tree-sitter-nix",
  "injectionNames": ["nix"],
  "fileTypes": ["nix"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:cstrahan/tree-sitter-nix#v0.3.0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "nix.wasm",
    "highlightsQuery": "nix-highlights.scm",
    "localsQuery": "nix-locals.scm",
    "tagsQuery": "nix-tags.scm"
  }
}
